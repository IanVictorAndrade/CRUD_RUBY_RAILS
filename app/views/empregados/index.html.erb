<div>
  <h1>Listando Funcionários</h1>
  <br/>

<br/><br/>

  <a href="<%= novo_empregado_path %>" class="btn btn-primary" style="margin: 10px 10px 10px 10px">Novo Funcionário</a>


  <% if @empregados.present? %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Sobrenome</th>
        <th>E-mail</th>
        <th>Telefone</th>
        <th>País</th>
        <th>Departamento</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @empregados.each do | empregado | %>
        <tr>
          <td><%= empregado.id %></td>
          <td><%= empregado.firstname %></td>
          <td><%= empregado.lastname %></td>
          <td><%= empregado.email %></td>
          <td><%= empregado.phone %></td>
          <td><%= empregado.country.name if empregado.country %></td>
          <td><%= empregado.department.name if empregado.department %></td>
          <td><%= link_to "Detalhes", exibicao_path(empregado), class: "btn btn-primary"%></td>
          <td><%= link_to "Editar", edit_empregado_path(empregado), class: "btn btn-secondary"%></td>
          <td><%= link_to "Excluir", delete_empregado_path(empregado), class: "btn btn-danger"%></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Nenhum funcionário cadastrado.</p>
<% end %>


</div>
