
<div>
  <h1>Cascading Dropdowns</h1>

  <%= form_with(url: offshoreempregados_path, method: :post) do |f| %>

    <fieldset>
      <div class="form-group row">
        <label>
          First Name:
          <span class="star">*</span>
        </label>
        <div class="col-sm-10">
          <%= f.text_field :first_name, placeholder: 'Enter First Name' , class: "form-control" %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <div class="form-group row">
        <label>
          Last Name:
          <span class="star">*</span>
        </label>
        <div class="col-sm-10">
          <%= f.text_field :last_name, placeholder: 'Enter Last Name' , class: "form-control" %>
        </div>
      </div>
    </fieldset>

    <div data-controller="cascadingselect">
      <fieldset>
        <div class="form-group row">
          <label>
            Country:
            <span class="star">*</span>
          </label>
          <div class="col-sm-10">
            <%= f.select :country_id, options_from_collection_for_select(select_country, 'id', 'name'), { include_blank: 'Select Country' },
            class: "form-control",
            autofocus: true,
            data: { action: "change->cascadingselect#loadStates", "cascadingselect-target": "countrySelect" }
            %>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <div class="form-group row">
          <label>
            State:
            <span class="star">*</span>
          </label>
          <div class="col-sm-10">
            <%= f.select :state_id, options_from_collection_for_select([], 'id', 'name'), { include_blank: 'Select State' }, class: "form-control", autofocus: true,
                         data: { action: "change->cascadingselect#loadCities", "cascadingselect-target": "stateSelect" } %>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <div class="form-group row">
          <label>
            City:
            <span class="star">*</span>
          </label>
          <div class="col-sm-10">
            <%= f.select :city_id, options_from_collection_for_select([], 'id', 'name'), { include_blank: 'Select City' }, class: "form-control", autofocus: true,
                         data: { "cascadingselect-target": "citySelect" }
            %>
          </div>
        </div>
      </fieldset>
    </div>





  <%= f.submit "Insert Record", class: "btn btn-primary" %>

  <% end %>




</div>
